{
  "sapplink": "1.0",
  "name": "sappkeys",
  "kind": "sampler",
  "midi": {
    "channelPolicy": "any",
    "polyphony": 96,
    "pitchBendRangeSemitones": 2
  },
  "parameters": [
    { "id": "masterGain", "label": "Master",       "cc": 7,   "range": [-24, 12],   "curve": "linear", "tags": ["volume"] },
    { "id": "touch",      "label": "Touch",        "cc": 14,  "range": [0, 1],      "curve": "linear", "tags": ["velocity", "response"] },
    { "id": "lid",        "label": "Lid",          "cc": 15,  "range": [0, 1],      "curve": "linear", "tags": ["brightness", "tone", "width"] },
    { "id": "resonance",  "label": "Resonance",    "cc": 16,  "range": [0, 1],      "curve": "linear", "tags": ["resonance", "sustain", "space"] },
    { "id": "mechNoise",  "label": "Mechanics",    "cc": 17,  "range": [0, 1],      "curve": "linear", "tags": ["noise", "realism", "imperfection"] },
    { "id": "width",      "label": "Width",        "cc": 18,  "range": [0, 2],      "curve": "linear", "tags": ["width", "space"] },
    { "id": "roomSize",   "label": "Room Size",    "cc": 19,  "range": [0.6, 1.4],  "curve": "linear", "tags": ["space"] },
    { "id": "roomDecay",  "label": "Room Decay",   "cc": 20,  "range": [0.2, 2.5],  "curve": "log",    "tags": ["space", "tail"] },
    { "id": "vintage",    "label": "Vintage",      "cc": 12,  "range": [0, 1],      "curve": "linear", "tags": ["vintage", "waver", "tape", "imperfection"] },
    { "id": "drive",      "label": "Drive",        "cc": 22,  "range": [0, 1],      "curve": "linear", "tags": ["drive", "saturation", "grit"] },
    { "id": "unaCorda",   "label": "Una Corda",    "cc": 67,  "range": [0, 1],      "curve": "linear", "tags": ["soft", "pedal", "tone"] },
    { "id": "roomLevel",  "label": "Room Level",   "cc": 91,  "range": [0, 1],      "curve": "linear", "tags": ["space", "reverb"] },
    { "id": "clean",      "label": "Clean",        "cc": 3,   "range": [0, 1],      "curve": "linear", "tags": ["clean", "imperfection"] }
  ],
  "hostParameters": [
    {
      "id": "preset",
      "label": "Preset",
      "type": "choice",
      "automatable": true,
      "choices": [
        "Grand Concert",
        "Intimate Grand",
        "Bright Grand",
        "EP Mark I",
        "EP Dyno",
        "EP Crunchy",
        "Una Corda Soft",
        "Honky Tonk"
      ],
      "note": "Factory names in program order, then user presets as \"<name> (user)\". User presets are per-machine (scanned from disk when the plugin is constructed), so only the factory names are listed here."
    }
  ],
  "presets": [
    { "name": "Grand Concert", "program": 0 },
    { "name": "Intimate Grand", "program": 1 },
    { "name": "Bright Grand", "program": 2 },
    { "name": "EP Mark I", "program": 3 },
    { "name": "EP Dyno", "program": 4 },
    { "name": "EP Crunchy", "program": 5 },
    { "name": "Una Corda Soft", "program": 6 },
    { "name": "Honky Tonk", "program": 7 }
  ],
  "articulations": []
}
